# Copy to .env and override for your environment.

# Database. Default is a local SQLite file. To connect the main business database,
# point this at your Postgres/MySQL instance, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
#   DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=sqlite:///./axxspace.db

# Admin login password (change this!).
ADMIN_PASSWORD=axxspace-admin

# Secret used to sign admin session tokens (change this to a long random value!).
SECRET_KEY=dev-secret-change-me
