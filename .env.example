# Copy to .env and override for your environment.

# --- Database ----------------------------------------------------------------
# Production (Render internal PostgreSQL):
#   Set DATABASE_URL to the "Internal Database URL" from your Render PostgreSQL
#   service dashboard. It looks like:
#     postgresql+psycopg2://user:password@dpg-xxxx-a.oregon-postgres.render.com/dbname
#
# Local development fallback (SQLite — do NOT use on Render):\
DATABASE_URL=sqlite:///./axxspace.db

# --- Admin credentials -------------------------------------------------------
# Admin login password (change this in production!)
ADMIN_PASSWORD=axxspace-admin

# Secret used to sign admin/member session tokens.
# Change this to a long random string in production (e.g. openssl rand -hex 32).
SECRET_KEY=dev-secret-change-me

# --- Email notifications (Gmail SMTP) ----------------------------------------
# Enable transactional email by filling in your Gmail credentials.
#
# IMPORTANT: Use a Gmail App Password, NOT your regular Gmail password.
# How to create one: https://support.google.com/accounts/answer/185833
#   1. Go to your Google Account → Security → 2-Step Verification (must be ON)
#   2. At the bottom of that page, click "App passwords"
#   3. Select "Mail" + "Other (custom name)" → name it "AXXSPACE"
#   4. Copy the 16-character password shown and paste it below.
#
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: override the display name shown to email recipients
EMAIL_FROM=AXXSPACE <your-gmail@gmail.com>
